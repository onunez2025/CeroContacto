# Variables que Dockploy debe inyectar en el stack de docker-compose
# (seccion "Environment Variables" del proyecto en Dockploy).
# No poner valores reales aqui - este archivo solo documenta los nombres.

C4C_BASE_URL=
C4C_USER=
C4C_PASSWORD=

SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
