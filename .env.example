# Variables que Dockploy debe inyectar en el stack de docker-compose
# (seccion "Environment Variables" del proyecto en Dockploy).
# No poner valores reales aqui - este archivo solo documenta los nombres.

C4C_BASE_URL=
C4C_USER=
C4C_PASSWORD=

SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true

# Correo de confirmacion al cliente via Microsoft Graph (permiso de
# aplicacion Mail.Send, sin usuario interactivo). Si falta cualquiera de
# estas cuatro, el formulario sigue funcionando y solo se omite el correo.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Buzon desde el que sale el correo (debe existir en el tenant).
MS_GRAPH_SENDER_EMAIL=

# URL publica del sitio, usada para el banner del correo. Si falta, el correo
# se envia igual pero sin imagen de cabecera.
PUBLIC_BASE_URL=
