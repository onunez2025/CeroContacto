# syntax=docker/dockerfile:1
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/c4c-client/package.json packages/c4c-client/package.json
COPY packages/backend/package.json packages/backend/package.json
RUN npm ci

COPY packages/shared packages/shared
COPY packages/c4c-client packages/c4c-client
COPY packages/backend packages/backend
RUN npm run build --workspace=@cerocontacto/shared \
 && npm run build --workspace=@cerocontacto/c4c-client \
 && npm run build --workspace=@cerocontacto/backend

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/c4c-client/package.json packages/c4c-client/package.json
COPY packages/backend/package.json packages/backend/package.json
RUN npm ci --omit=dev

COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/c4c-client/dist packages/c4c-client/dist
COPY --from=build /app/packages/backend/dist packages/backend/dist

EXPOSE 3000
CMD ["node", "packages/backend/dist/server.js"]
